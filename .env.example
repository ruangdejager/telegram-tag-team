# Comma-separated list of device/unit IDs to poll and merge into sessions
UNIT_IDS=866049074634379,866049074634403

TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Farmranger API base URL
API_BASE=https://api.services.farmrangersa.com/v2/unit/

# How often (seconds) to poll the API for new logs
POLL_INTERVAL_SECONDS=300

# Discovery timestamps are rounded to the nearest bracket of this many minutes
# (e.g. 15 -> 12:00, 12:15, 12:30, ...). All blocks (any device, even repeats
# from the same device) that round to the same bracket become one session.
MERGE_BRACKET_MINUTES=15

# Where to persist "last seen" state between restarts
STATE_FILE=./data/state.json

# Where to persist extra opted-in chat IDs (admin chat is always subscribed)
SUBSCRIBERS_FILE=./data/subscribers.json

# Hard lower bound (ISO date) for all history queries / charts — device data isn't
# valid before this date. Change this (e.g. as a Railway service variable) if the
# valid data range ever moves; no code change needed.
HISTORY_START=2026-06-20
