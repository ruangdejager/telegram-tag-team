# ── Process-global settings (shared by every bot) ────────────────────────────

# The tagexplore-web app's base URL (no trailing slash). Every bit of data the
# bot shows is read from here — the bot never touches the Farmranger logs itself.
WEB_API_BASE=https://tagexplore.up.railway.app

# Shared secret matching the web app's BOT_PROVISION_TOKEN. Only the manager bot
# uses it, to attach a new bot to an org and set its dev/client level. Leave blank
# if you won't run the manager bot (existing bots keep working from registry.json).
WEB_PROVISION_TOKEN=

# How often to poll the web app for new discoveries (seconds).
POLL_SECONDS=60

# How long a bracket's content must stay unchanged before it's announced — absorbs
# multiple readers landing in the same bracket a few seconds/minutes apart.
SETTLE_SECONDS=120

# How often to re-pull org name/level/whitelist from the web app (minutes).
CONTEXT_REFRESH_MINUTES=10

# Sliding window of history kept in memory for missing-tag detection etc.
LIVE_WINDOW_HOURS=72

# A tag is "missing" if seen in the live window but not in the last N hours.
MISSING_THRESHOLD_HOURS=8

# Hard lower bound (ISO date) for all history queries / charts — device data isn't
# valid before this date.
HISTORY_START=2026-06-20

# Base dir for registry.json and each bot's per-bot state/subscribers.
# On Railway point this at the mounted volume, e.g. /data.
DATA_DIR=./data

# ── Manager bot (optional) ───────────────────────────────────────────────────
# A separate, owner-gated Telegram bot to attach/remove worker bots live. Leave
# blank to disable. Only MANAGER_CHAT_ID may operate it. Needs WEB_API_BASE and
# WEB_PROVISION_TOKEN set to mint org access tokens.
MANAGER_BOT_TOKEN=
MANAGER_CHAT_ID=

# ── Mapbox (optional; enables 🛰 Map and 🔥 Heat buttons) ────────────────────
# Public token from https://account.mapbox.com/access-tokens (free tier is 50k
# static-image loads/month). If unset, those buttons reply with a friendly
# "not configured" message instead of crashing.
MAPBOX_TOKEN=
