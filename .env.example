# ── Process-global settings (shared by every bot) ────────────────────────────

# Farmranger API base URL
API_BASE=https://api.services.farmrangersa.com/v2/unit/

# Minute past the hour on which to poll (Farmranger uploads at :15, so :20 is safe).
POLL_MINUTE=20

# Sliding window of history kept in memory for missing-tag detection etc.
LIVE_WINDOW_HOURS=72

# A tag is "missing" if seen in the live window but not in the last N hours.
MISSING_THRESHOLD_HOURS=8

# Discovery timestamps are rounded to the nearest bracket of this many minutes
# (e.g. 15 -> 12:00, 12:15, 12:30, ...). All blocks (any device, even repeats
# from the same device) that round to the same bracket become one session.
MERGE_BRACKET_MINUTES=15

# Hard lower bound (ISO date) for all history queries / charts — device data isn't
# valid before this date.
HISTORY_START=2026-06-20

# Base dir for registry.json and each bot's per-bot state/subscribers.
# On Railway point this at the mounted volume, e.g. /data.
DATA_DIR=./data

# ── Manager bot (optional) ───────────────────────────────────────────────────
# A separate, owner-gated Telegram bot to add/remove/configure worker bots live.
# Leave blank to disable. Only MANAGER_CHAT_ID may operate it.
MANAGER_BOT_TOKEN=
MANAGER_CHAT_ID=

# ── Mapbox (optional; enables 🛰 Map and 🔥 Heat buttons) ────────────────────
# Public token from https://account.mapbox.com/access-tokens (free tier is 50k
# static-image loads/month). If unset, those buttons reply with a friendly
# "not configured" message instead of crashing.
MAPBOX_TOKEN=

# ── Legacy single-bot seed (optional) ────────────────────────────────────────
# If registry.json is empty and these are set, one bot is seeded from them on boot
# (level defaults to dev). Once the registry exists, these are ignored — the manager
# bot / registry.json are the source of truth. New deployments can skip these and add
# bots via the manager bot instead.
# UNIT_IDS=866049074634379,866049074634403
# TELEGRAM_BOT_TOKEN=your-bot-token-here
# TELEGRAM_CHAT_ID=your-chat-id-here
# LEGACY_BOT_ID=primary
# LEGACY_BOT_NAME=Tag Monitor
# LEGACY_BOT_LEVEL=dev
